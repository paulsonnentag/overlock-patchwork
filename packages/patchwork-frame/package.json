{
  "name": "patchwork-frame",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build"
  },
  "patchwork": {
    "server": "wss://subduction.sync.inkandswitch.com"
  },
  "exports": {
    "./patchwork-frame-component.json": "./dist/patchwork-frame-component.json",
    "./document-selection-provider-component.json": "./dist/document-selection-provider-component.json",
    "./document-selection-url-sync-component.json": "./dist/document-selection-url-sync-component.json"
  },
  "plugins": {
    "component": [
      {
        "name": "patchwork-frame",
        "module": "./src/frame.tsx"
      },
      {
        "name": "document-selection-provider",
        "module": "./src/document-selection-provider.tsx"
      },
      {
        "name": "document-selection-url-sync",
        "module": "./src/document-selection-url-sync.tsx"
      }
    ]
  },
  "dependencies": {
    "patchwork-dom": "link:../patchwork-dom",
    "patchwork-solid": "link:../patchwork-solid"
  },
  "devDependencies": {
    "@automerge/automerge-repo": "2.6.0-subduction.13",
    "patchwork-vite-plugin": "link:../patchwork-vite-plugin",
    "solid-js": "^1.9.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-css-injected-by-js": "^4.0.1",
    "vite-plugin-solid": "^2.11.0"
  }
}
