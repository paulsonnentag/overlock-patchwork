{
  "name": "patchwork-bootstrap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build"
  },
  "patchwork": {
    "server": "wss://subduction.sync.inkandswitch.com"
  },
  "exports": {
    "./app-root-component.json": "./dist/app-root-component.json",
    "./account-provider-component.json": "./dist/account-provider-component.json"
  },
  "plugins": {
    "component": [
      {
        "name": "app-root",
        "module": "./src/app-root.tsx"
      },
      {
        "name": "account-provider",
        "module": "./src/account-provider.tsx"
      }
    ]
  },
  "dependencies": {
    "@inkandswitch/patchwork-filesystem": "^0.0.5",
    "patchwork-dom": "link:../patchwork-dom",
    "patchwork-plugins": "link:../patchwork-plugins",
    "patchwork-solid": "link:../patchwork-solid"
  },
  "devDependencies": {
    "@automerge/automerge-repo": "2.6.0-subduction.13",
    "patchwork-vite-plugin": "link:../patchwork-vite-plugin",
    "solid-js": "^1.9.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-css-injected-by-js": "^4.0.1",
    "vite-plugin-solid": "^2.11.0"
  }
}
