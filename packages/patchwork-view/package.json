{
  "name": "patchwork-view",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "patchwork-view component: picks the first plugin component whose schema validates the open document.",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch"
  },
  "patchwork": {
    "server": "wss://subduction.sync.inkandswitch.com"
  },
  "plugins": {
    "component": [
      {
        "name": "patchwork-view",
        "module": "./src/patchwork-view.tsx"
      }
    ]
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "patchwork-plugins-provider": "link:../patchwork-plugins-provider"
  },
  "devDependencies": {
    "@automerge/automerge-repo": "2.6.0-subduction.13",
    "patchwork-dom": "link:../patchwork-dom",
    "patchwork-solid": "link:../patchwork-solid",
    "patchwork-vite-plugin": "link:../patchwork-vite-plugin",
    "solid-js": "^1.9.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-css-injected-by-js": "^4.0.1",
    "vite-plugin-solid": "^2.11.0"
  }
}
