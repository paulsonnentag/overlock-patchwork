{
  "name": "tldraw",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Automerge-backed tldraw canvas. Vite builds the src manifest into a dist manifest and JS bundle.",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch"
  },
  "patchwork": {
    "server": "wss://subduction.sync.inkandswitch.com"
  },
  "plugins": {
    "component": [
      {
        "name": "tldraw-editor",
        "module": "./src/tldraw-editor.tsx",
        "schema": "./src/schemas/tldraw.ts"
      },
      {
        "name": "new-tldraw-button",
        "module": "./src/new-tldraw-button.tsx",
        "schema": "./src/schemas/folder.ts"
      }
    ]
  },
  "dependencies": {
    "@automerge/automerge-repo-react-hooks": "2.6.0-subduction.17",
    "@inkandswitch/patchwork-filesystem": "0.0.5",
    "@tldraw/tldraw": "4.3.1",
    "@types/lodash": "^4.17.20",
    "lodash": "^4.17.21",
    "patchwork-schemas": "link:../patchwork-schemas",
    "tldraw": "4.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@automerge/automerge": "3.2.6",
    "@automerge/automerge-repo": "2.6.0-subduction.17",
    "@inkandswitch/patchwork-bootloader": "0.0.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "patchwork-dom": "link:../patchwork-dom",
    "patchwork-vite-plugin": "link:../patchwork-vite-plugin",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-css-injected-by-js": "^4.0.1",
    "vite-plugin-wasm": "^3.4.1"
  },
  "exports": {
    "./tldraw-editor-component.json": "./dist/tldraw-editor-component.json",
    "./new-tldraw-button-component.json": "./dist/new-tldraw-button-component.json"
  }
}
