{
  "name": "patchwork-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "React bindings for patchwork-dom: registerComponent (React component factory) and useHandle for StateHandle / DocHandle.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "patchwork": {
    "server": "wss://subduction.sync.inkandswitch.com"
  },
  "peerDependencies": {
    "@automerge/automerge-repo": "*",
    "patchwork-dom": "*",
    "react": "^18"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "patchwork-dom": "link:../patchwork-dom",
    "react": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
