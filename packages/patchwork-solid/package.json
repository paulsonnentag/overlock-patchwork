{
  "name": "patchwork-solid",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Solid bindings for patchwork-dom: withSolid (Solid-flavored registerView) and useHandle for StateHandle / DocHandle.",
  "main": "./dist/patchwork-solid.js",
  "module": "./dist/patchwork-solid.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/patchwork-solid.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "patchwork": {
    "server": "wss://subduction.sync.inkandswitch.com"
  },
  "peerDependencies": {
    "patchwork-dom": "*",
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@automerge/automerge-repo": "2.6.0-subduction.13",
    "@automerge/automerge-repo-solid-primitives": "2.6.0-subduction.15",
    "patchwork-dom": "link:../patchwork-dom",
    "solid-js": "^1.9.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-solid": "^2.11.0"
  }
}
