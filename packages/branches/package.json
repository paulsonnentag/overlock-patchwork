{
  "name": "branches",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build"
  },
  "patchwork": {
    "server": "wss://subduction.sync.inkandswitch.com"
  },
  "plugins": {
    "component": [
      {
        "name": "checked-out-branch-provider",
        "module": "./src/checked-out-branch-provider.tsx"
      },
      {
        "name": "branch-picker",
        "module": "./src/branch-picker.tsx",
        "schema": "./src/schemas/any.ts"
      }
    ]
  },
  "dependencies": {
    "patchwork-dom": "link:../patchwork-dom",
    "patchwork-schemas": "link:../patchwork-schemas",
    "patchwork-solid": "link:../patchwork-solid"
  },
  "devDependencies": {
    "@automerge/automerge-repo": "2.6.0-subduction.13",
    "patchwork-vite-plugin": "link:../patchwork-vite-plugin",
    "solid-js": "^1.9.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-css-injected-by-js": "^4.0.1",
    "vite-plugin-solid": "^2.11.0"
  },
  "exports": {
    "./checked-out-branch-provider-component.json": "./dist/checked-out-branch-provider-component.json",
    "./branch-picker-component.json": "./dist/branch-picker-component.json"
  }
}
