{
  "name": "sequencer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Music collaboration tool. Vite builds the src manifest into a dist manifest and JS bundle.",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch"
  },
  "patchwork": {
    "server": "wss://subduction.sync.inkandswitch.com"
  },
  "plugins": {
    "component": [
      {
        "name": "sequencer-editor",
        "module": "./src/sequencer.tsx",
        "schema": "./src/schemas/sequencer.ts"
      },
      {
        "name": "new-sequencer-button",
        "module": "./src/new-sequencer-button.tsx",
        "schema": "./src/schemas/folder.ts"
      }
    ]
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "jszip": "^3.10.1",
    "lodash": "^4.17.21",
    "patchwork-schemas": "link:../patchwork-schemas",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@automerge/automerge-repo": "*"
  },
  "devDependencies": {
    "@automerge/automerge": "3.2.5",
    "@types/lodash": "^4.17.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "patchwork-dom": "link:../patchwork-dom",
    "patchwork-react": "link:../patchwork-react",
    "patchwork-vite-plugin": "link:../patchwork-vite-plugin",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-css-injected-by-js": "^4.0.1"
  },
  "exports": {
    "./new-sequencer-button-component.json": "./dist/new-sequencer-button-component.json",
    "./sequencer-editor-component.json": "./dist/sequencer-editor-component.json"
  }
}
